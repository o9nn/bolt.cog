{
  "name": "bolt-cog-desktop",
  "productName": "Bolt Cog C",
  "version": "0.3.3",
  "description": "C17-only coding edition with real model generation and isolated Docker compile/run",
  "author": "o9nn",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/o9nn/bolt.cog",
  "repository": {
    "type": "git",
    "url": "https://github.com/o9nn/bolt.cog.git"
  },
  "main": "main.cjs",
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.cjs tests/provider-probe.cjs tests/c-api.cjs",
    "smoke": "node scripts/smoke.cjs",
    "check-version": "node scripts/check-version.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "build:runtime": "node scripts/build-runtime.cjs"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.o9nn.boltcog.c17",
    "productName": "Bolt Cog C",
    "executableName": "bolt-cog-desktop",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "policy.cjs",
      "smoke-runtime.cjs",
      "terminal-smoke.cjs",
      "offline.html",
      "assets/icon.png",
      "package.json",
      "preferences.cjs",
      "settings.cjs",
      "settings-preload.cjs",
      "settings.html",
      "settings.js",
      "terminal-display-smoke.cjs",
      "c-edition.json",
      "c-smoke.cjs"
    ],
    "artifactName": "BoltCog-C-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "assets/icon.png",
      "maintainer": "o9nn",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libnss3",
        "libgtk-3-0",
        "libgbm1",
        "libasound2",
        "libxss1",
        "libxtst6",
        "xdg-utils"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BoltCog-C-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "BoltCog-C-${version}-win-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "beforePack": "./scripts/check-runtime.cjs"
  },
  "desktopName": "Bolt Cog C"
}
